{
    "framework": "nextjs",
    "functions": {
        "api/index.py": {
            "maxDuration": 60
        },
        "api/dados.py": {
            "maxDuration": 30
        }
    },
    "rewrites": [
        {
            "source": "/api/dados/:rota",
            "destination": "/api/dados"
        },
        {
            "source": "/:segredo/mcp",
            "destination": "/api/index"
        }
    ]
}
