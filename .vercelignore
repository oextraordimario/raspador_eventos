# Só o read-path sobe no deploy: o front (app/, lib/, package.json,
# next.config.mjs) e as funções Python (api/, src/, sql/, vercel.json).
# Nunca subir segredo local nem peso morto.
# O requirements.txt da raiz é do write-path local (playwright/pandas) — fica
# fora do upload; as deps das funções vêm do pyproject.toml (só mcp + psycopg),
# e as do front, do package.json.
requirements.txt
.env
.env.*
*.db
data/
docs/
tests/
capturas_*.json
__pycache__/
*.ipynb
.claude/
.codex/
.mcp.json
CLAUDE.md
README.md
